# Both of these ship in the browser bundle and are public by design — the
# security boundary is the RLS policies and SECURITY DEFINER functions in
# supabase/migrations, not the secrecy of these values.
#
# Get them from Supabase: Project Settings -> API.
# On a machine linked to Vercel: vercel env pull .env.local --yes
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- billing ---
# Server only: read by the functions in api/, never by the browser. None of
# these may ever carry a VITE_ prefix, which would ship them to every student's
# phone. In production they live in Vercel (Settings -> Environment Variables).

# Supabase: Project Settings -> API keys -> the secret (service_role) key.
# The webhook uses it to write teacher_plans, the one table no browser can.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: Developers -> API keys. sk_test_... in the sandbox.
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint (whsec_...). Locally it is the one
# `stripe listen` prints, which is not the one the dashboard shows.
STRIPE_WEBHOOK_SECRET=
# The Teacher product's two prices (price_...): $8 a month and $72 a year.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Optional. Where Stripe sends a teacher back to; defaults to the address the
# request came in on, which is right everywhere except behind a proxy.
# SITE_URL=https://example.com
# Optional. Set to 1 once Stripe Tax is switched on in the dashboard.
# STRIPE_AUTOMATIC_TAX=1
