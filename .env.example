# Both of these ship in the browser bundle and are public by design — the
# security boundary is the RLS policies and SECURITY DEFINER functions in
# supabase/migrations, not the secrecy of these values.
#
# Get them from Supabase: Project Settings -> API.
# On a machine linked to Vercel: vercel env pull .env.local --yes
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never add the service_role key here. A VITE_ prefix would ship it to every
# student's phone, and nothing in this app needs it.
